{
  "healthPath": "/health",
  "legacyStatePaths": [
    "database",
    "keys/installation.key",
    "postgres",
    "secrets/credential.key"
  ],
  "networkMode": "host",
  "schemaVersion": 1,
  "services": [
    {
      "command": "node build/index.js",
      "critical": false,
      "dependencies": [
        "migrate"
      ],
      "environment": {},
      "kind": "longrun",
      "name": "bot",
      "requiredForHealth": true,
      "runAsRoot": false,
      "workspace": "apps/bot",
      "writablePaths": []
    },
    {
      "command": "/usr/local/libexec/discord-stonker-bot/migrate",
      "critical": false,
      "dependencies": [
        "postgres"
      ],
      "environment": {},
      "kind": "oneshot",
      "name": "migrate",
      "requiredForHealth": false,
      "runAsRoot": false,
      "workspace": "apps/bot",
      "writablePaths": []
    },
    {
      "command": "/usr/lib/postgresql/17/bin/postgres -D \"${NOVA_DATABASE_DIRECTORY}\" -c \"hba_file=/etc/discord-stonker-bot/pg_hba.conf\" -c \"listen_addresses=\" -c \"log_destination=stderr\" -c \"logging_collector=off\" -c \"port=5432\" -c \"unix_socket_directories=${POSTGRES_RUNTIME_DIRECTORY:-/tmp/postgresql}\" -c \"unix_socket_permissions=0777\"",
      "critical": true,
      "dependencies": [
        "prepare-postgres"
      ],
      "environment": {},
      "kind": "longrun",
      "name": "postgres",
      "requiredForHealth": true,
      "runAsRoot": false,
      "workspace": "apps/bot",
      "writablePaths": []
    },
    {
      "command": "/usr/local/libexec/discord-stonker-bot/prepare-postgres",
      "critical": false,
      "dependencies": [
        "prepare-state"
      ],
      "environment": {},
      "kind": "oneshot",
      "name": "prepare-postgres",
      "requiredForHealth": false,
      "runAsRoot": false,
      "workspace": "apps/bot",
      "writablePaths": [
        "/tmp/postgresql"
      ]
    },
    {
      "command": "/usr/local/libexec/discord-stonker-bot/prepare-state",
      "critical": false,
      "dependencies": [],
      "environment": {},
      "kind": "oneshot",
      "name": "prepare-state",
      "requiredForHealth": false,
      "runAsRoot": false,
      "workspace": "apps/bot",
      "writablePaths": []
    },
    {
      "command": "node build/web.js",
      "critical": true,
      "dependencies": [
        "migrate"
      ],
      "environment": {},
      "kind": "longrun",
      "name": "web",
      "port": 22604,
      "requiredForHealth": true,
      "runAsRoot": false,
      "workspace": "apps/bot",
      "writablePaths": []
    },
    {
      "command": "node build/worker.js",
      "critical": true,
      "dependencies": [
        "migrate"
      ],
      "environment": {},
      "kind": "longrun",
      "name": "worker",
      "requiredForHealth": true,
      "runAsRoot": false,
      "workspace": "apps/bot",
      "writablePaths": []
    }
  ],
  "stateEnvironment": "DATA_DIRECTORY",
  "workspaces": [
    {
      "packageName": "discord-stonker-bot-app-bot",
      "path": "apps/bot",
      "profile": "background-service",
      "runtimePaths": [
        "examples",
        "migrations"
      ]
    }
  ]
}
