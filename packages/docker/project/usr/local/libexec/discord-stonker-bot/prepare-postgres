#!/command/with-contenv sh
set -eu

. /usr/local/libexec/nova-docker/log

data_directory="${NOVA_DATABASE_DIRECTORY:-/config/database}"
runtime_directory="${POSTGRES_RUNTIME_DIRECTORY:-/tmp/postgresql}"
database_name="${POSTGRES_DB:-stonker}"
database_user="${POSTGRES_USER:-stonker}"

if ! printf '%s\n' "${database_name}" | grep -Eq '^[a-z][a-z0-9_]*$'; then
  nova_log ERROR prepare-postgres 'POSTGRES_DB must start with a lowercase letter and contain only lowercase letters, digits, or underscores.'

  exit 1
fi

if ! printf '%s\n' "${database_user}" | grep -Eq '^[a-z][a-z0-9_]*$'; then
  nova_log ERROR prepare-postgres 'POSTGRES_USER must start with a lowercase letter and contain only lowercase letters, digits, or underscores.'

  exit 1
fi

# Older setups passed these, and they must keep starting, so each is noted once and ignored.
if [ -n "${POSTGRES_PASSWORD:-}" ]; then
  nova_log WARN prepare-postgres 'POSTGRES_PASSWORD is no longer used and is ignored because PostgreSQL accepts only local Unix-socket connections.'
fi

if [ -n "${POSTGRES_PORT:-}" ]; then
  nova_log WARN prepare-postgres 'POSTGRES_PORT is no longer used and is ignored because PostgreSQL uses its fixed internal port only.'
fi

mkdir -p -- "${data_directory}" "${runtime_directory}"

chmod 0700 "${data_directory}"
chmod 0755 "${runtime_directory}"

# Only local socket connections are allowed, so the cluster needs no password.
if [ ! -s "${data_directory}/PG_VERSION" ]; then
  directory_entry="$(find "${data_directory}" -mindepth 1 -maxdepth 1 -print -quit)"

  if [ -n "${directory_entry}" ]; then
    nova_log ERROR prepare-postgres "PostgreSQL data directory ${data_directory} is non-empty but has no PG_VERSION marker."

    exit 1
  fi

  nova_log INFO prepare-postgres "Initializing PostgreSQL data at ${data_directory}."

  /usr/lib/postgresql/17/bin/initdb \
    --auth-host=reject \
    --auth-local=trust \
    --encoding=UTF8 \
    --locale=C \
    --pgdata="${data_directory}" \
    --username="${database_user}"
fi
