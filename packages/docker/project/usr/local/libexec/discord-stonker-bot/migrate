#!/command/with-contenv sh
set -eu

database_name="${POSTGRES_DB:-stonker}"
database_user="${POSTGRES_USER:-stonker}"
database_password="${POSTGRES_PASSWORD:-}"
database_port="${POSTGRES_PORT:-5432}"
runtime_directory="${POSTGRES_RUNTIME_DIRECTORY:-/run/postgresql}"
application_user_id="${PUID:-1000}"
application_group_id="${PGID:-1000}"
attempt=0

run_as_application() {
  /command/s6-applyuidgid \
    -u "${application_user_id}" \
    -g "${application_group_id}" \
    -G "${application_group_id}" \
    "$@"
}

until run_as_application \
  /usr/lib/postgresql/17/bin/pg_isready \
  --dbname=postgres \
  --host="${runtime_directory}" \
  --port="${database_port}" \
  --username="${database_user}" \
  --quiet
do
  attempt=$((attempt + 1))

  if [ "${attempt}" -ge 60 ]; then
    echo 'PostgreSQL did not become ready within 60 seconds.' >&2
    exit 1
  fi

  sleep 1
done

database_exists="$(
  run_as_application \
    /usr/lib/postgresql/17/bin/psql \
    --dbname=postgres \
    --host="${runtime_directory}" \
    --no-align \
    --port="${database_port}" \
    --tuples-only \
    --username="${database_user}" \
    --variable=ON_ERROR_STOP=1 \
    --command="SELECT 1 FROM pg_database WHERE datname = '${database_name}';"
)"

if [ "${database_exists}" != '1' ]; then
  run_as_application \
    /usr/lib/postgresql/17/bin/createdb \
    --host="${runtime_directory}" \
    --port="${database_port}" \
    --username="${database_user}" \
    "${database_name}"
fi

printf '%s\n' "ALTER ROLE CURRENT_USER WITH PASSWORD :'database_password';" \
  | run_as_application \
    /usr/lib/postgresql/17/bin/psql \
    --dbname=postgres \
    --host="${runtime_directory}" \
    --port="${database_port}" \
    --username="${database_user}" \
    --variable=database_password="${database_password}" \
    --variable=ON_ERROR_STOP=1

cd /app/apps/bot

exec /command/s6-applyuidgid \
  -u "${application_user_id}" \
  -g "${application_group_id}" \
  -G "${application_group_id}" \
  /usr/local/bin/node \
  build/migrate.js
