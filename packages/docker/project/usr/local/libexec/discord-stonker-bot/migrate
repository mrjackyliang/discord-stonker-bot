#!/command/with-contenv sh
set -eu

. /usr/local/libexec/nova-docker/log

database_name="${POSTGRES_DB:-stonker}"
database_user="${POSTGRES_USER:-stonker}"
runtime_directory="${POSTGRES_RUNTIME_DIRECTORY:-/tmp/postgresql}"
attempt=0

until /usr/lib/postgresql/17/bin/pg_isready \
  --dbname=postgres \
  --host="${runtime_directory}" \
  --port=5432 \
  --username="${database_user}" \
  --quiet
do
  attempt=$((attempt + 1))

  if [ "${attempt}" -ge 60 ]; then
    nova_log ERROR migrate 'PostgreSQL did not become ready within 60 seconds.'

    exit 1
  fi

  sleep 1
done

database_exists="$(
  /usr/lib/postgresql/17/bin/psql \
    --dbname=postgres \
    --host="${runtime_directory}" \
    --no-align \
    --port=5432 \
    --tuples-only \
    --username="${database_user}" \
    --variable=ON_ERROR_STOP=1 \
    --command="SELECT 1 FROM pg_database WHERE datname = '${database_name}';"
)"

if [ "${database_exists}" != '1' ]; then
  /usr/lib/postgresql/17/bin/createdb \
    --host="${runtime_directory}" \
    --port=5432 \
    --username="${database_user}" \
    "${database_name}"
fi

# Version 4.0 set a password for TCP sign-in; the socket never asks for one, so it is cleared.
/usr/lib/postgresql/17/bin/psql \
  --dbname=postgres \
  --host="${runtime_directory}" \
  --port=5432 \
  --quiet \
  --username="${database_user}" \
  --variable=ON_ERROR_STOP=1 \
  --command='ALTER ROLE CURRENT_USER WITH PASSWORD NULL;'

cd /app/apps/bot

exec /usr/local/bin/node build/migrate.js
