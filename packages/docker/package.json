{
  "name": "discord-stonker-bot-tool-docker",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "check": "nova utility run-scripts --sequential \"check:*\"",
    "check:dockerfile": "docker build --check --file ../../Dockerfile ../..",
