#!/command/with-contenv sh
set -eu

exec /command/s6-setuidgid postgres \
  /usr/lib/postgresql/17/bin/postgres \
  -D "${POSTGRES_DATA_DIRECTORY:-/data/postgres}" \
  -c "listen_addresses=127.0.0.1" \
  -c "log_destination=stderr" \
  -c "logging_collector=off" \
  -c "password_encryption=scram-sha-256" \
  -c "port=${POSTGRES_PORT:-5432}" \
  -c "unix_socket_directories=${POSTGRES_RUNTIME_DIRECTORY:-/run/postgresql}" \
  -c "unix_socket_permissions=0777"
