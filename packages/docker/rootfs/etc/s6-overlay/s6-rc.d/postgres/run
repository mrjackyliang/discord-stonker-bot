#!/command/with-contenv sh
set -eu
. /usr/local/libexec/nova-docker/log
. /run/nova-docker/environment
if [ -f /app/.pnp.cjs ]; then
  export NODE_OPTIONS="--require=/app/.pnp.cjs${NODE_OPTIONS:+ ${NODE_OPTIONS}}"
fi
if [ -f /app/.pnp.loader.mjs ]; then
  export NODE_OPTIONS="--experimental-loader=/app/.pnp.loader.mjs${NODE_OPTIONS:+ ${NODE_OPTIONS}}"
fi
cd '/app/apps/bot'
nova_log INFO 'postgres' 'Starting service.'
exec /command/s6-applyuidgid -u "${PUID:-1000}" -g "${PGID:-1000}" -G "${PGID:-1000}" /usr/lib/postgresql/17/bin/postgres -D "${NOVA_DATABASE_DIRECTORY}" -c "hba_file=/etc/discord-stonker-bot/pg_hba.conf" -c "listen_addresses=" -c "log_destination=stderr" -c "logging_collector=off" -c "port=5432" -c "unix_socket_directories=${POSTGRES_RUNTIME_DIRECTORY:-/tmp/postgresql}" -c "unix_socket_permissions=0777"
