#!/command/with-contenv sh
set -eu

service_name="${1:-unknown}"
exit_code="${2:-0}"
signal_number="${3:-0}"

if [ "${exit_code}" -ne 0 ] || [ "${signal_number}" -ne 0 ]; then
  echo "Critical service ${service_name} exited (code=${exit_code}, signal=${signal_number}); stopping the appliance." >&2
  exec /run/s6/basedir/bin/halt
fi

exit 0
