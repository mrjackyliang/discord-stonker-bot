<%
const dataSettingsGuildName = data.settingsGuildName;
const dataSettingsGuildMemberCount = data.settingsGuildMemberCount;
const dataSettingsPremiumTier = data.settingsGuildPremiumTier;
const dataSettingsRequestUrl = data.settingsRequestUrl;
const dataRecaptchaSiteKey = data.recaptchaSiteKey;
%>
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark">
  <title>Join <%= dataSettingsGuildName %></title>
  <style>
    :root {
      color-scheme: dark;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      --background: #16171b;
      --card: #23252b;
      --card-soft: #2b2e35;
      --copy: #f5f6f8;
      --muted: #a9adb8;
      --accent: #5865f2;
      --accent-hover: #6975f5;
      --success: #3ba55d;
      --border: rgba(255, 255, 255, 0.09);
    }

    * {
      box-sizing: border-box;
    }

    body {
      min-height: 100vh;
      margin: 0;
      display: grid;
      place-items: center;
      padding: 32px 18px;
      color: var(--copy);
      background:
        radial-gradient(circle at 15% 10%, rgba(88, 101, 242, 0.22), transparent 34rem),
        radial-gradient(circle at 90% 90%, rgba(59, 165, 93, 0.13), transparent 28rem),
        var(--background);
    }

    main {
      width: min(100%, 720px);
      overflow: hidden;
      border: 1px solid var(--border);
      border-radius: 24px;
      background: rgba(35, 37, 43, 0.96);
      box-shadow: 0 28px 90px rgba(0, 0, 0, 0.38);
    }

    .hero {
      padding: 44px 44px 32px;
      background: linear-gradient(135deg, rgba(88, 101, 242, 0.2), rgba(35, 37, 43, 0));
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin: 0 0 16px;
      color: #c7cbff;
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .eyebrow::before {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: var(--success);
      content: "";
      box-shadow: 0 0 0 5px rgba(59, 165, 93, 0.13);
    }

    h1 {
      margin: 0;
      font-size: clamp(2rem, 7vw, 3.7rem);
      line-height: 1.02;
      letter-spacing: -0.045em;
    }

    .lede {
      max-width: 580px;
      margin: 18px 0 0;
      color: var(--muted);
      font-size: 1.04rem;
      line-height: 1.65;
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
      padding: 0 44px 28px;
    }

    .stat {
      padding: 18px;
      border: 1px solid var(--border);
      border-radius: 14px;
      background: var(--card-soft);
    }

    .stat strong,
    .stat span {
      display: block;
    }

    .stat strong {
      font-size: 1.15rem;
    }

    .stat span {
      margin-top: 4px;
      color: var(--muted);
      font-size: 0.82rem;
    }

    form {
      padding: 28px 44px 44px;
      border-top: 1px solid var(--border);
    }

    .checklist {
      display: grid;
      gap: 10px;
      margin: 0 0 24px;
      padding: 0;
      list-style: none;
      color: var(--muted);
    }

    .checklist li::before {
      margin-right: 9px;
      color: var(--success);
      content: "✓";
      font-weight: 900;
    }

    .recaptcha-note {
      margin: 0 0 18px;
      padding: 12px 14px;
      border: 1px solid var(--border);
      border-radius: 10px;
      color: var(--muted);
      background: #1c1e23;
      font-size: 0.78rem;
      overflow-wrap: anywhere;
    }

    button {
      width: 100%;
      border: 0;
      border-radius: 12px;
      padding: 15px 20px;
      color: white;
      background: var(--accent);
      font: inherit;
      font-weight: 800;
      cursor: pointer;
      transition: background 150ms ease, transform 150ms ease;
    }

    button:hover {
      background: var(--accent-hover);
      transform: translateY(-1px);
    }

    .fine-print {
      margin: 16px 0 0;
      color: var(--muted);
      font-size: 0.76rem;
      line-height: 1.5;
      text-align: center;
    }

    @media (max-width: 560px) {
      .hero,
      form {
        padding-right: 24px;
        padding-left: 24px;
      }

      .stats {
        grid-template-columns: 1fr;
        padding-right: 24px;
        padding-left: 24px;
      }
    }
  </style>
</head>
<body>
  <main>
    <section class="hero">
      <p class="eyebrow">Self-hosted community access</p>
      <h1>Join <%= dataSettingsGuildName %></h1>
      <p class="lede">
        Enter a community with independently operated moderation, helpful
        tooling, and clearly separated automation modules.
      </p>
    </section>

    <section class="stats" aria-label="Server information">
      <div class="stat">
        <strong><%= dataSettingsGuildMemberCount %></strong>
        <span>community members</span>
      </div>
      <div class="stat">
        <strong>Tier <%= dataSettingsPremiumTier %></strong>
        <span>Discord boost level</span>
      </div>
    </section>

    <form method="post" action="<%= dataSettingsRequestUrl %>">
      <ul class="checklist">
        <li>Review the server rules before participating.</li>
        <li>Never share passwords, tokens, private keys, or seed phrases.</li>
        <li>Be respectful, and keep discussions in the right channels.</li>
      </ul>

      <p class="recaptcha-note" data-sitekey="<%= dataRecaptchaSiteKey %>">
        Automated invite protection is configured for this request.
      </p>

      <button type="submit">Continue to Discord</button>
      <p class="fine-print">
        The invite is short-lived and intended only for the person requesting it.
      </p>
    </form>
  </main>
</body>
</html>
