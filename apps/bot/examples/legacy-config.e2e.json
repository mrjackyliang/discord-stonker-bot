  "auto-replies": [
    {
      "name": "Help and command discovery",
      "channels": [
        {
          "description": "General",
          "channel-id": "1197999049811439729"
        }
      ],
      "regex": {
        "description": "Members asking the bot for help",
        "pattern": "^(?:stonker[ ,:]*)?(?:help|commands)\\??$",
        "flags": "i"
      },
      "payloads": [
        {
          "content": "I am being rebuilt with a database-backed control panel. An operator can enable each reviewed module from the dashboard."
        },
        {
          "content": "Need a hand? Ask a moderator while the modern slash-command catalog is being completed."
        }
      ],
      "reply": true
    },
    {
      "name": "Scam-report guidance",
      "channels": [
        {
          "description": "General",
          "channel-id": "1197999049811439729"
        }
      ],
      "regex": {
        "description": "Members asking how to report suspicious activity",
        "pattern": "^(?:how (?:do|can) i )?report (?:a )?(?:scam|scammer)\\??$",
        "flags": "i"
