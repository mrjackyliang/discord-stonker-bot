  "detect-suspicious-words": {
    "categories": [
      {
        "category": "Credential theft",
        "words": [
          "send me your password",
          "verify your account",
          "log in to claim your reward",
          "share your two-factor code"
        ]
      },
      {
        "category": "Impersonated support",
        "words": [
          "official support will dm you",
          "message me for account recovery",
          "admin needs your password"
        ]
      },
      {
        "category": "Invite spam",
        "words": [
          "join my server",
          "check out my server",
          "dm me for an invite"
        ]
      }
    ],
    "channel": {
      "description": "Moderator only",
      "channel-id": "1209383231867326487"
    }
  },
