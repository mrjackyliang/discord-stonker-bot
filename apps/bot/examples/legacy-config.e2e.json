  "regex-rules": [
    {
      "name": "Block unsolicited Discord invite links",
      "channel": {
        "description": "General",
        "channel-id": "1197999049811439729"
      },
      "match": true,
      "regex": {
        "description": "Discord invite URLs",
        "pattern": "(?:discord\\.gg/|discord(?:app)?\\.com/invite/)[A-Za-z0-9-]+",
        "flags": "i"
      },
      "direct-message-payload": {
        "content": "Your message included a Discord invite link. Please ask a moderator before promoting another server."
      }
    },
    {
      "name": "Block common credential-harvesting links",
      "channel": {
        "description": "General",
        "channel-id": "1197999049811439729"
      },
      "match": true,
      "regex": {
        "description": "Suspicious account verification wording followed by a URL",
        "pattern": "(?:verify|validate|confirm|restore)\\s+(?:your\\s+)?account.{0,80}https?://",
        "flags": "i"
      },
      "direct-message-payload": {
        "content": "Your message matched a credential-harvesting safety rule and was removed for moderator review."
      }
    }
  ],
  "remove-affiliates": {
    "platforms": [
      {
        "platform": "Generic referral parameters",
        "regex": {
          "description": "Common affiliate and campaign query parameters",
          "pattern": "[?&](?:tag|ref|affiliate|aff_id|utm_(?:source|medium|campaign))=[^\\s&#]+",
          "flags": "i"
        }
      },
      {
        "platform": "Amazon associate tags",
        "regex": {
          "description": "Amazon URLs containing an associate tag",
          "pattern": "https?://(?:www\\.)?amazon\\.[^/\\s]+/[^\\s]*[?&]tag=[^\\s&#]+",
          "flags": "i"
        }
      }
    ],
    "channel": {
      "description": "General",
      "channel-id": "1197999049811439729"
    },
    "direct-message-payload": {
      "content": "Your post contained an affiliate or campaign-tracking link. Please share a clean destination URL instead."
    }
  },
