{
  "name": "discord-stonker-bot-app-bot",
  "version": "4.0.0",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "nova utility run-scripts --parallel --node-env development \"dev:*\"",
    "dev:start": "tsx watch --env-file-if-exists=.env src/index.ts",
    "dev:web": "vite",
    "prod": "nova utility run-scripts --sequential --node-env production \"prod:*\"",
    "prod:start": "node --env-file-if-exists=.env build/index.js",
    "check": "nova utility run-scripts --sequential \"check:*\"",
    "check:lint": "eslint ./ --max-warnings=0",
    "check:types-source": "nova utility type-check --project tsconfig.source.json",
    "check:types-config": "nova utility type-check --project tsconfig.config.json",
    "check:types-tests": "nova utility type-check --project tsconfig.tests.json",
    "check:types-web": "nova utility type-check --project tsconfig.web.json",
    "check:test": "vitest run",
    "build": "nova utility run-scripts --sequential --node-env production \"build:*\"",
    "build:reset": "shx rm -rf ./build",
    "build:transpile": "nova utility transpile --project tsconfig.source.json",
    "build:web": "vite build",
    "clean": "nova utility run-scripts --parallel \"clean:*\"",
    "clean:build": "shx rm -rf ./build",
    "mock": "vite --mode mock",
    "e2e": "nova utility run-scripts --sequential --node-env test \"e2e:*\"",
    "e2e:build": "docker build --file ../../Dockerfile --tag discord-stonker-bot:e2e ../..",
    "e2e:test": "playwright test --config=playwright-config.mjs"
  },
  "engines": {
    "node": "^22 || ^24 || ^26"
  },
  "dependencies": {
    "@node-rs/argon2": "2.0.2",
    "@simplewebauthn/server": "13.3.3",
    "discord.js": "14.27.0",
    "express": "4.22.3",
    "express-rate-limit": "7.5.0",
    "fast-xml-parser": "5.11.2",
    "nodemailer": "10.2.1",
    "otpauth": "9.4.1",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cbnventures/nova": "0.40.1",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.64.1",
    "@simplewebauthn/browser": "13.2.2",
    "@types/express": "4.17.25",
    "@types/node": "24.9.1",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "notyf": "3.10.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shx": "0.4.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "4.1.11"
  }
}
